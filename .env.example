# Local environment variables (copy to .env.local)

# Contact form (production) — same Resend pattern as BarndoBuilderList
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL="GeneratorInstallerList <your verified sender>"
# CONTACT_TO_EMAIL=austin@hometeamtechnology.com

# Outrank blog — see docs/outrank-setup.md
# Articles are pushed via Outrank's publish webhook and stored in Vercel Blob.
# Provisioned automatically when the `generator-blog` Blob store was linked; pull
# with `vercel env pull`.
# BLOB_READ_WRITE_TOKEN=
# BLOB_BASE_URL=https://<store>.public.blob.vercel-storage.com
# Shared secret for the Outrank publish webhook (any long random string).
# Must match the "Access token" configured on the Outrank webhook integration.
# OUTRANK_WEBHOOK_SECRET=
# Vercel deploy hook the webhook POSTs after saving articles.
# DEPLOY_HOOK_URL=
